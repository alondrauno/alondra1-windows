<UserControl x:Class="Alondra1.App.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Alondra1.App.Notes"
             xmlns:ui="clr-namespace:Alondra1.App.Controls"
             SizeChanged="View_SizeChanged">
  <UserControl.Resources>
    <!-- Rows with the same rounded selection as To-do. -->
    <Style x:Key="NoteRow" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessName}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NoteRow}">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
      <Setter Property="AllowDrop" Value="True"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- Notes need the local database; if it could not be opened, say why (other modules keep working). -->
    <Border Style="{StaticResource Pane}" Padding="16" Visibility="{Binding IsAvailable, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
      <TextBlock Text="Notes are not available because the local database could not be opened. Mail and the other modules keep working." TextWrapping="Wrap"/>
    </Border>

    <Grid x:Name="Root" Visibility="{Binding IsAvailable, Converter={StaticResource BoolVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FoldersColumn" Width="210"/>
        <ColumnDefinition x:Name="ListColumn" Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Left: views and folders ===== -->
      <Border x:Name="FoldersPane" Style="{StaticResource Pane}" Margin="0,0,6,0">
        <DockPanel Margin="6">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Style="{StaticResource QuietButton}" Click="NewFolder_Click" AutomationProperties.Name="New folder" ToolTip="New folder">
              <StackPanel Orientation="Horizontal"><ui:Alondra1Icon Kind="Add" IconSize="15" Margin="0,0,6,0" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="New folder"/></StackPanel>
            </Button>
          </StackPanel>
          <ListBox x:Name="NavList" ItemsSource="{Binding Sidebar}" BorderThickness="0" Background="Transparent"
                   AutomationProperties.Name="Note views and folders" ItemContainerStyle="{StaticResource NavItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="NavList_SelectionChanged"
                   PreviewMouseRightButtonDown="NavList_RightClick" Drop="NavList_Drop" DragOver="NavList_DragOver">
            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="local:NoteNavItem">
                <Grid MinHeight="34" Margin="{Binding Margin}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ui:Alondra1Icon Kind="{Binding Icon}" IconSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===== Middle: note list ===== -->
      <Border x:Name="ListPane" Grid.Column="1" Style="{StaticResource Pane}" Margin="0,0,6,0">
        <DockPanel Margin="6">
          <Grid DockPanel.Dock="Top" Margin="4,2,2,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="FoldersToggle" Style="{StaticResource IconButton}" Click="FoldersToggle_Click" AutomationProperties.Name="Show or hide folders" ToolTip="Folders">
              <ui:Alondra1Icon Kind="Menu" IconSize="16"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Click="EmptyTrash_Click" AutomationProperties.Name="Empty trash" ToolTip="Empty trash"
                      Visibility="{Binding IsTrashView, Converter={StaticResource BoolVis}}">
                <ui:Alondra1Icon Kind="Delete" IconSize="16"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Click="NewNote_Click" AutomationProperties.Name="New note" ToolTip="New note (Ctrl+N)">
                <ui:Alondra1Icon Kind="Compose" IconSize="17" Foreground="{DynamicResource BlueBrush}"/>
              </Button>
            </StackPanel>
          </Grid>
          <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Text="{Binding EmptyText}" Style="{StaticResource HelperText}" Margin="10,12" TextWrapping="Wrap"/>
          <ListBox x:Name="NoteList" ItemsSource="{Binding Items}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                   AutomationProperties.Name="Notes" ItemContainerStyle="{StaticResource NoteRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   SelectionChanged="NoteList_SelectionChanged" KeyDown="NoteList_KeyDown" PreviewMouseRightButtonDown="NoteList_RightClick"
                   PreviewMouseLeftButtonDown="NoteList_MouseDown" PreviewMouseMove="NoteList_MouseMove">
            <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="local:NoteItem">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                      <ui:Alondra1Icon DockPanel.Dock="Right" Kind="PriorityFilled" IconSize="13" Foreground="{DynamicResource StarBrush}" Margin="6,0,0,0"
                                       Visibility="{Binding Favorite, Converter={StaticResource BoolVis}}"/>
                      <ui:Alondra1Icon DockPanel.Dock="Left" Kind="Promote" IconSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,4,0"
                                       Visibility="{Binding Pinned, Converter={StaticResource BoolVis}}"/>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Width="44" Height="44" CornerRadius="6" Margin="8,0,0,0" ClipToBounds="True"
                          Visibility="{Binding Thumbnail, Converter={StaticResource NotNullVis}}">
                    <Image Source="{Binding Thumbnail, Converter={StaticResource Thumbnail}}" Stretch="UniformToFill"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===== Right: editor ===== -->
      <Border x:Name="EditorPane" Grid.Column="2" Style="{StaticResource Pane}" ClipToBounds="True">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,6,8,0">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="Back_Click" AutomationProperties.Name="Back to the note list" ToolTip="Back" Visibility="Collapsed">
              <ui:Alondra1Icon Kind="Back" IconSize="16"/>
            </Button>
            <Button x:Name="ListToggle" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="ListToggle_Click" AutomationProperties.Name="Focus on the note (hide the lists)" ToolTip="Focus on the note">
              <ui:Alondra1Icon Kind="Layout" IconSize="16"/>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}">
              <Button Style="{StaticResource QuietButton}" Click="Link_Click" AutomationProperties.Name="Link this note to an event, contact or task" ToolTip="Link to an event, contact or task">
                <StackPanel Orientation="Horizontal"><ui:Alondra1Icon Kind="Attachment" IconSize="15" Margin="0,0,6,0"/><TextBlock Text="Link"/></StackPanel>
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
              </Button>
              <Button x:Name="NoteMoreButton" Style="{StaticResource IconButton}" Click="NoteMore_Click" AutomationProperties.Name="More note actions" ToolTip="Export, import and more">
                <ui:Alondra1Icon Kind="More" IconSize="18"/>
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
              </Button>
            </StackPanel>
            <!-- Linked objects: click to open; the x removes the link (the object itself is not changed). -->
            <ItemsControl ItemsSource="{Binding Links}" VerticalAlignment="Center" Margin="6,0" AutomationProperties.Name="Linked items">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="local:NoteLinkChip">
                  <Border Style="{StaticResource Chip}" Margin="0,2,6,2">
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource QuietButton}" Padding="2,0" Content="{Binding Text}" Click="LinkChip_Click" Tag="{Binding}"
                              AutomationProperties.Name="{Binding Text, StringFormat='Open {0}'}" MaxWidth="240"/>
                      <Button Style="{StaticResource IconButton}" Width="22" Height="22" Click="LinkRemove_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Text, StringFormat='Remove link {0}'}">
                        <ui:Alondra1Icon Kind="Close" IconSize="11"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
          <!-- A sync conflict of the open note (Notes spec 10.2): both versions were kept; compare and choose. -->
          <Border DockPanel.Dock="Top" Margin="8,6,8,0" Padding="12,8" CornerRadius="6" Background="{DynamicResource SelectedBrush}"
                  BorderBrush="{DynamicResource AccentWarmBrush}" BorderThickness="0,0,0,2"
                  Visibility="{Binding HasConflict, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Sync conflict">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Compare versions" Click="CompareVersions_Click"
                      AutomationProperties.Name="Compare the two versions of this note"/>
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                         Text="This note was changed on another device and on this PC before they synced. Both versions were kept."/>
            </DockPanel>
          </Border>
          <Grid>
            <local:NoteEditorHost x:Name="Editor" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
              <ui:Alondra1Icon Kind="Notes" IconSize="40" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Select a note, or create one." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,10" HorizontalAlignment="Center"/>
              <Button Style="{StaticResource QuietButton}" Click="NewNote_Click" HorizontalAlignment="Center" AutomationProperties.Name="New note">
                <StackPanel Orientation="Horizontal"><ui:Alondra1Icon Kind="Add" IconSize="15" Margin="0,0,6,0" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="New note"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
