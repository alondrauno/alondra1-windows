<Window x:Class="Alondra1.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Alondra1.App.Shell"
        xmlns:tasks="clr-namespace:Alondra1.App.Tasks"
        xmlns:notes="clr-namespace:Alondra1.App.Notes"
        xmlns:ui="clr-namespace:Alondra1.App.Controls"
        xmlns:app="clr-namespace:Alondra1.App"
        Title="Alondra1"
        Width="1180" Height="760" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <app:FolderIconConverter x:Key="FolderIcon"/>
    <!-- Unread messages: heavier sender and subject (together with the dot, so unread never relies on color). -->
    <Style x:Key="UnreadText" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsUnread}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource ChromeBrush}" CornerRadius="14">
    <!-- Shell rows (docs/UI-DESIGN.md → Spacing contract): header 56, gap 8, toolbar 48, gap 8, content.
         The toolbar and content are inset 10 px from the window's left, right, and bottom edges. -->
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="{StaticResource ShellSurfaceGapRow}"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="{StaticResource ShellSurfaceGapRow}"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Workspace background (Settings → Appearance → Background). Behind everything; never inside mail bodies, inputs, or popups. -->
      <Image x:Name="BackgroundImage" Grid.RowSpan="5" IsHitTestVisible="False" Visibility="Collapsed" Stretch="UniformToFill"
             RenderOptions.BitmapScalingMode="LowQuality"/>
      <Rectangle x:Name="BackgroundOverlay" Grid.RowSpan="5" IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource ChromeBrush}"/>

      <!-- ===== Row 1: application header ===== -->
      <!-- Light scrim behind the header labels; transparent unless a background picture is showing. -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderScrimBrush}" IsHitTestVisible="False"/>
      <Grid x:Name="Header" Grid.Row="0" Height="{StaticResource HeaderHeight}" Margin="14,0,6,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/logo-64.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="Alondra1" IsHitTestVisible="False"/>
          <TextBlock x:Name="Wordmark" Text="Alondra1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,1"
                     Foreground="{DynamicResource TextBrush}" Visibility="{Binding ShowWordmark, Converter={StaticResource BoolVis}}"/>
          <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Demo" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
          </Border>
        </StackPanel>

        <!-- Workspace tabs: one strip of rounded, browser-style tabs (style WorkspaceTab), centered in the 56 px header. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource WorkspaceTabStripMargin}">
          <ItemsControl ItemsSource="{Binding Workspaces}" AutomationProperties.Name="Modules" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource WorkspaceTab}" Tag="{Binding IsSelected}" Click="Workspace_Click" CommandParameter="{Binding Name}"
                        AutomationProperties.Name="{Binding AccessName}" ToolTip="{Binding Name}"
                        Visibility="{Binding InOverflow, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                  <StackPanel Orientation="Horizontal">
                    <ui:Alondra1Icon Kind="{Binding Icon}" IconSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="{StaticResource WorkspaceTabIconGap}"
                               Visibility="{Binding DataContext.ShowNavLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                    <Border Style="{StaticResource Chip}" Margin="{StaticResource WorkspaceTabIconGap}" Padding="5,0" Visibility="{Binding Soon, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="Soon" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="NavMoreButton" Style="{StaticResource IconButton}" Click="NavMore_Click" AutomationProperties.Name="More modules" ToolTip="More modules"
                  Visibility="{Binding HasNavOverflow, Converter={StaticResource BoolVis}}">
            <ui:Alondra1Icon Kind="More" IconSize="18" Foreground="{DynamicResource MutedBrush}"/>
            <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
          </Button>
        </StackPanel>

        <!-- Shared search (Mail UI spec §8): the scope button says what is searched (this folder or module, all mail, or
             all of Alondra1); the box filters the module in place or shows grouped results below. -->
        <Grid x:Name="SearchArea" Grid.Column="2" MaxWidth="560" MinWidth="200" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
              Visibility="{Binding ShowSearchBox, Converter={StaticResource BoolVis}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SearchScopeButton" Style="{StaticResource SearchScopeButton}" Click="SearchScope_Click" Margin="0,0,4,0"
                  AutomationProperties.Name="{Binding Search.ScopeAccessName}" ToolTip="{Binding Search.ScopeToolTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Search.ScopeLabel}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
          </Button>
          <Grid Grid.Column="1">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" AutomationProperties.Name="{Binding SearchPlaceholder}"
                   ToolTip="{Binding SearchPlaceholder}" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" GotKeyboardFocus="SearchBox_GotKeyboardFocus"/>
          <ui:Alondra1Icon Kind="Search" IconSize="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="{Binding SearchPlaceholder}" IsHitTestVisible="False" Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button HorizontalAlignment="Right" Margin="0,0,3,0" Width="28" Height="28" Click="ClearSearch_Click" AutomationProperties.Name="Clear search" ToolTip="Clear search">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="MinHeight" Value="0"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
            <ui:Alondra1Icon Kind="Close" IconSize="14" Foreground="{DynamicResource MutedBrush}"/>
          </Button>
          </Grid>
        </Grid>
        <ToggleButton x:Name="SearchToggle" Grid.Column="2" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                      AutomationProperties.Name="{Binding SearchPlaceholder}" ToolTip="{Binding SearchPlaceholder}" Checked="SearchToggle_Checked"
                      Visibility="{Binding ShowSearchButton, Converter={StaticResource BoolVis}}">
          <ui:Alondra1Icon Kind="Search" IconSize="18"/>
        </ToggleButton>
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchToggle}" Placement="Bottom" HorizontalOffset="-220" StaysOpen="False"
               AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SearchToggle}" Opened="SearchPopup_Opened">
          <Border Margin="0,4,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusLg}" Padding="6" Width="260" Effect="{StaticResource PopupShadow}">
            <StackPanel>
              <Button x:Name="CompactScopeButton" Style="{StaticResource SearchScopeButton}" Click="SearchScope_Click" HorizontalAlignment="Left" Margin="0,0,0,6"
                      AutomationProperties.Name="{Binding Search.ScopeAccessName}" ToolTip="{Binding Search.ScopeToolTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Search.ScopeLabel}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
              </Button>
              <TextBox x:Name="CompactSearchBox" Style="{StaticResource SearchBox}" Padding="10,6" AutomationProperties.Name="{Binding SearchPlaceholder}"
                       TextChanged="CompactSearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown"/>
            </StackPanel>
          </Border>
        </Popup>

        <!-- Search results (All, All mail, Calendar): grouped by module in a fixed order, each heading with its count
             and what was searched; results open in their own module. -->
        <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchArea}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
               IsOpen="{Binding Search.IsPanelOpen}" Closed="SearchResultsPopup_Closed">
          <Border Margin="0,6,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusLg}" Width="560" MaxHeight="540" Effect="{StaticResource PopupShadow}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="14,10,8,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Click="CloseSearchResults_Click"
                        AutomationProperties.Name="Close search results" ToolTip="Close search results (Esc)">
                  <ui:Alondra1Icon Kind="Close" IconSize="14" Foreground="{DynamicResource MutedBrush}"/>
                </Button>
                <TextBlock x:Name="SearchStatusText" Text="{Binding Search.Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
              <ListBox x:Name="SearchResultsList" ItemsSource="{Binding Search.Rows}" BorderThickness="0" Background="Transparent" Margin="6,0,6,8"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                       AutomationProperties.Name="Search results" KeyDown="SearchResults_KeyDown" MouseUp="SearchResults_MouseUp">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessName}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHeading}" Value="True">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <StackPanel Margin="4,10,4,2" Visibility="{Binding IsHeading, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                          <ui:Alondra1Icon Kind="{Binding Icon}" IconSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="20,1,0,0"/>
                      </StackPanel>
                      <Grid Margin="18,4,4,4" Visibility="{Binding IsHeading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                          <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,1,0,0"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Meta}"/>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Popup>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="Settings" ToolTip="Settings" Margin="0,0,8,0">
            <ui:Alondra1Icon Kind="Settings" IconSize="20" Foreground="{DynamicResource MutedBrush}"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="40" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
          <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Width="40" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Maximize_Click" AutomationProperties.Name="Maximize" ToolTip="Maximize"/>
          <Button Style="{StaticResource IconButton}" Width="40" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Close_Click" AutomationProperties.Name="Close" ToolTip="Close"/>
        </StackPanel>
      </Grid>

      <!-- ===== Row 2: module toolbar ===== -->
      <!-- Toolbar groups: account | 16 | status | 8 · divider · 8 | folder tabs (8 px between tabs). Every surface is 36 px on one center line. -->
      <Border x:Name="Toolbar" Grid.Row="2" Style="{StaticResource Toolbar}" Margin="{StaticResource ShellToolbarMargin}">
        <DockPanel VerticalAlignment="Center" LastChildFill="True">
          <!-- Sync button carrying the connection status (Mail, Calendar, Notes, Contacts), then the account selector
               (Calendar, Notes, Contacts; Mail picks its account in View settings). -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasAccountSelector, Converter={StaticResource BoolVis}}">
            <Button x:Name="SyncButton" Style="{StaticResource SyncButton}" Command="{Binding SyncCommand}"
                    ToolTip="{Binding SyncToolTip}" AutomationProperties.Name="{Binding SyncAccessName}" AutomationProperties.LiveSetting="Polite">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Alondra1Icon Kind="Refresh" IconSize="16" VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource PaneControlGapLeft}"/>
                <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource PaneControlGapLeft}" VerticalAlignment="Center"
                           Visibility="{Binding ShowStatusLabel, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </Button>
            <ComboBox x:Name="AccountBox" Style="{StaticResource ToolbarSelector}" Height="{StaticResource ControlMd}" VerticalAlignment="Center" Margin="{StaticResource ToolbarGroupGapLeft}"
                      AutomationProperties.Name="Account" ToolTip="Account" SelectionChanged="AccountBox_SelectionChanged"
                      Visibility="{Binding ShowToolbarAccountSelector, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource ToolbarDivider}"/>
          </StackPanel>

          <!-- Module area fills the rest of the row; only the current module is visible. -->
          <Grid>
          <!-- Mail -->
          <DockPanel Visibility="{Binding IsMail, Converter={StaticResource BoolVis}}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewMailCommand}" AutomationProperties.Name="New mail" ToolTip="New mail (Ctrl+N)" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <ui:Alondra1Icon Kind="Compose" IconSize="16" VerticalAlignment="Center"/>
                  <TextBlock Text="New mail" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowNewLabel, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ReplyCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Reply" ToolTip="Reply (Ctrl+R)">
                <ui:Alondra1Icon Kind="Reply" IconSize="18"/>
              </Button>
              <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSecondaryMailActions, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource IconButton}" Command="{Binding ReplyAllCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Reply all" ToolTip="Reply all">
                  <ui:Alondra1Icon Kind="ReplyAll" IconSize="18"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Forward" ToolTip="Forward (Ctrl+Shift+F)">
                  <ui:Alondra1Icon Kind="Forward" IconSize="18"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding ArchiveCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Archive" ToolTip="Archive">
                  <ui:Alondra1Icon Kind="Archive" IconSize="18"/>
                </Button>
              </StackPanel>
              <Button Style="{StaticResource DangerIconButton}" Command="{Binding DeleteCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Delete" ToolTip="Delete (Del)">
                <ui:Alondra1Icon Kind="Delete" IconSize="18"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ToggleReadCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="{Binding ReadToggleLabel}" ToolTip="{Binding ReadToggleLabel}"
                      Visibility="{Binding ShowSecondaryMailActions, Converter={StaticResource BoolVis}}">
                <ui:Alondra1Icon Kind="{Binding ReadToggleIcon}" IconSize="18"/>
              </Button>
              <Border Style="{StaticResource ToolbarDivider}"/>
              <ToggleButton x:Name="LayoutButton" Style="{StaticResource IconButton}" AutomationProperties.Name="View settings" ToolTip="View settings">
                <ui:Alondra1Icon Kind="Layout" IconSize="18"/>
              </ToggleButton>
              <Popup IsOpen="{Binding IsChecked, ElementName=LayoutButton}" PlacementTarget="{Binding ElementName=LayoutButton}"
                     Placement="Bottom" HorizontalOffset="-230" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
                <Border Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="12" Width="280" Effect="{StaticResource PopupShadow}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsAllAccounts}">
                      <TextBlock Text="Group" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="MailGrouping" Width="150" HorizontalAlignment="Right" SelectionChanged="MailGrouping_Changed" AutomationProperties.Name="Group messages">
                        <ComboBoxItem Content="Together"/><ComboBoxItem Content="By account"/>
                      </ComboBox>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Folders" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="FolderDockBox" Width="150" HorizontalAlignment="Right" SelectionChanged="FolderDockBox_SelectionChanged" AutomationProperties.Name="Folders position"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Reading pane" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="ReaderDockBox" Width="150" HorizontalAlignment="Right" SelectionChanged="ReaderDockBox_SelectionChanged" AutomationProperties.Name="Reading pane position"/>
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="Density" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="DensityBox" Width="150" HorizontalAlignment="Right" SelectionChanged="DensityBox_SelectionChanged" AutomationProperties.Name="Density"/>
                    </DockPanel>
                    <TextBlock Text="Accounts and folders are in the sidebar; Hidden puts them behind the folder button." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Popup>
              <Button x:Name="MailMoreButton" Style="{StaticResource IconButton}" Click="MailMore_Click" AutomationProperties.Name="More mail actions" ToolTip="More">
                <ui:Alondra1Icon Kind="More" IconSize="18"/>
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
              </Button>
            </StackPanel>

            <!-- Current view and the sidebar toggle; folders themselves live in the sidebar (Mail UI spec §4). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" Click="SidebarToggle_Click"
                      AutomationProperties.Name="{Binding SidebarToggleLabel}" ToolTip="{Binding SidebarToggleLabel}">
                <ui:Alondra1Icon Kind="Folder" IconSize="18"/>
              </Button>
              <TextBlock Text="{Binding ScopeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                         AutomationProperties.Name="{Binding ScopeTitle, StringFormat='Showing {0}'}"/>
            </StackPanel>
          </DockPanel>

          <!-- Calendar -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsCalendar, Converter={StaticResource BoolVis}}">
            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="Previous month" ToolTip="Previous month">
              <ui:Alondra1Icon Kind="Back" IconSize="16"/>
            </Button>
            <TextBlock Text="{Binding MonthLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" MinWidth="130" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Style="{StaticResource IconButton}" Command="{Binding NextMonthCommand}" AutomationProperties.Name="Next month" ToolTip="Next month">
              <ui:Alondra1Icon Kind="Next" IconSize="16"/>
            </Button>
          </StackPanel>

          <!-- To-do -->
          <tasks:TodoToolbar DataContext="{Binding Todo}" Visibility="{Binding DataContext.IsTasks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>

          <!-- Notes: actions live in the Notes panes; the toolbar shows sort order. -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotes, Converter={StaticResource BoolVis}}">
            <ui:Alondra1Icon Kind="Sort" IconSize="16" Foreground="{DynamicResource MutedBrush}" Margin="4,0,6,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="NoteSortBox" ItemsSource="{Binding Notes.SortOptions}" MinWidth="128" SelectionChanged="NoteSortBox_SelectionChanged" AutomationProperties.Name="Sort notes by" ToolTip="Sort notes"/>
          </StackPanel>

          <!-- Contacts -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsContacts, Converter={StaticResource BoolVis}}">
            <ui:Alondra1Icon Kind="Contacts" IconSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding VisibleContacts.Count, StringFormat='{}{0} people'}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>          </Grid>
        </DockPanel>
      </Border>

      <!-- ===== Content ===== -->
      <Grid x:Name="ContentArea" Grid.Row="4" Margin="{StaticResource ShellContentMargin}">
        <!-- Panes are separated by exactly one 8 px gutter (LayoutArranger.Gutter); the splitter hit target fills that gutter. -->
        <shell:MailDockPanel x:Name="Dock"
                             FoldersDock="{Binding PaneFoldersDock}"
                             ReadingDock="{Binding ReadingDock}"
                             FolderBreadth="{Binding FolderBreadth, Mode=OneWay}"
                             ReadingBreadth="{Binding ReadingBreadth, Mode=OneWay}"
                             Visibility="{Binding IsMail, Converter={StaticResource BoolVis}}"
                             BreadthCommitted="Dock_BreadthCommitted"
                             SizeChanged="Dock_SizeChanged">
          <!-- Accounts and folders (Mail UI spec §3.1): All accounts with the unified folders, then every account with its
               standard and custom folders. Independent scroll; Up/Down move, Left/Right collapse and expand, Enter opens. -->
          <Border Style="{StaticResource Pane}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
                <Button Style="{StaticResource QuietButton}" Command="{Binding AccountsCommand}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Add or manage accounts" ToolTip="Add an account, or change one (Settings → Accounts)">
                  <StackPanel Orientation="Horizontal">
                    <ui:Alondra1Icon Kind="Add" IconSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Accounts" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </DockPanel>
              <ListBox x:Name="NavList" ItemsSource="{Binding NavRows}" BorderThickness="0" Background="Transparent" Margin="6,8,6,0"
                       AutomationProperties.Name="Accounts and folders"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       SelectionChanged="NavList_SelectionChanged" KeyDown="NavList_KeyDown" ContextMenuOpening="NavList_ContextMenuOpening">
                <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="32"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessName}"/>
                    <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                    <Setter Property="IsEnabled" Value="True"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Padding="4,0" Margin="0,1">
                            <Grid>
                              <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Margin="-4,7,0,7" CornerRadius="1.5" Background="{DynamicResource BrandBrush}" Visibility="Collapsed"/>
                              <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                              <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="{Binding Indent}" MinHeight="32">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Expand / collapse (rows with folders under them). -->
                      <Button Grid.Column="0" Width="20" Height="24" Padding="0" Click="NavExpander_Click" Tag="{Binding}" Focusable="False"
                              Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}"
                              AutomationProperties.Name="{Binding Label, StringFormat='Expand or collapse {0}'}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/></Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ChevronGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                      </Button>
                      <!-- Account marker (initials, supplemental to the name and address) or the folder icon. -->
                      <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrandBrush}" Margin="0,0,8,0"
                              Visibility="{Binding IsAccount, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnBrandBrush}"/>
                      </Border>
                      <ui:Alondra1Icon Grid.Column="1" Kind="{Binding Icon}" IconSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                        Visibility="{Binding IsFolder, Converter={StaticResource BoolVis}}"/>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeading}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsAccount}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasUnread}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                <DataTrigger Binding="{Binding NotSynced}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsAccount, Converter={StaticResource BoolVis}}"/>
                        <!-- Provider sync state of this account (text, not only color); the tooltip has the last sync and reason. -->
                        <TextBlock Text="{Binding SyncBadge}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSyncBadge, Converter={StaticResource BoolVis}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SyncAttention}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <!-- Unread count: a number, never only a color; unknown counts show nothing (see the row's name). -->
                      <TextBlock Grid.Column="3" Text="{Binding UnreadText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,4,0"
                                 Foreground="{DynamicResource TextBrush}" Typography.NumeralAlignment="Tabular"
                                 Visibility="{Binding HasUnread, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <!-- Message list: 16 px pane padding; header row 48 (title left, view + count right); 12 px gap; 32 px column row;
               the column row and every message row share MailColumns, so From / Subject / Received stay aligned. -->
          <Border x:Name="ListPane" Style="{StaticResource ContentPane}" ClipToBounds="True">
            <DockPanel>
              <Grid x:Name="ListHeader" DockPanel.Dock="Top" Style="{StaticResource PaneHeaderRow}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedFolder}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding ScopeAccountLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="{StaticResource PaneControlGapLeft}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- Filter (unread, flagged, attachments, account) and sort: labelled menus; the active state shows as chips below. -->
                  <Button x:Name="ListFilterButton" Style="{StaticResource IconButton}" Width="30" Height="30" Click="ListFilter_Click" Margin="0,0,2,0"
                          AutomationProperties.Name="Filter messages" ToolTip="Filter: unread, flagged, with attachments, account">
                    <ui:Alondra1Icon Kind="Filter" IconSize="16">
                      <ui:Alondra1Icon.Style>
                        <Style TargetType="ui:Alondra1Icon">
                          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFilter}" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrandBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:Alondra1Icon.Style>
                    </ui:Alondra1Icon>
                    <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                  </Button>
                  <Button x:Name="ListSortButton" Style="{StaticResource IconButton}" Width="30" Height="30" Click="ListSort_Click" Margin="0,0,8,0"
                          AutomationProperties.Name="{Binding SortLabel, StringFormat=Sort messages. Now: {0}}" ToolTip="{Binding SortLabel, StringFormat=Sort: {0}}">
                    <ui:Alondra1Icon Kind="Sort" IconSize="16" Foreground="{DynamicResource MutedBrush}"/>
                    <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                  </Button>
                  <TextBlock x:Name="MessageCountText" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding CountText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
              </Grid>
              <!-- Active filters as chips, each removable, plus Clear filters. Hidden when no filter applies. -->
              <WrapPanel x:Name="FilterChipBar" DockPanel.Dock="Top" Margin="0,4,0,0" Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding FilterChips}" Focusable="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SearchScopeButton}" Background="{DynamicResource SelectedBrush}" Height="26" MinHeight="26" Padding="10,0" Margin="0,0,6,4" FontSize="12"
                              Click="RemoveFilterChip_Click" AutomationProperties.Name="{Binding Label, StringFormat=Remove filter {0}}" ToolTip="Remove this filter">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                          <ui:Alondra1Icon Kind="Close" IconSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource QuietButton}" Height="26" MinHeight="26" Padding="8,0" Margin="0,0,0,4" FontSize="12" Content="Clear filters"
                        Click="ClearFilters_Click" AutomationProperties.Name="Clear all filters"/>
              </WrapPanel>
              <Border x:Name="ListColumnHeader" DockPanel.Dock="Top" Height="{StaticResource MailTableHeaderHeight}" Margin="{StaticResource PaneSectionGapTop}"
                      Background="{DynamicResource SubtleBrush}" CornerRadius="{StaticResource RadiusTip}">
                <Grid ui:MailColumns.Apply="True">
                  <!-- Column headers sort the list; the sorted column shows an arrow (direction), its name says it too. -->
                  <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Tag="From" Click="ColumnSort_Click" HorizontalAlignment="Left"
                          AutomationProperties.Name="Sort by sender" ToolTip="Sort by sender">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="From"/><TextBlock Text="{Binding FromSortArrow}" Margin="4,0,0,0"/></StackPanel>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButton}" Tag="Subject" Click="ColumnSort_Click" HorizontalAlignment="Left"
                          AutomationProperties.Name="Sort by subject" ToolTip="Sort by subject">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Subject"/><TextBlock Text="{Binding SubjectSortArrow}" Margin="4,0,0,0"/></StackPanel>
                  </Button>
                  <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Tag="Date" Click="ColumnSort_Click" HorizontalAlignment="Right"
                          AutomationProperties.Name="Sort by date received" ToolTip="Sort by date received"
                          Visibility="{Binding ShowTimeColumn, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DateSortArrow}" Margin="0,0,4,0"/><TextBlock Text="Received"/></StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Grid>
                <ListBox x:Name="MessageList" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Message list"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Extended"
                         SelectionChanged="MessageList_SelectionChanged"
                         PreviewMouseLeftButtonUp="MessageList_PreviewMouseLeftButtonUp"
                         KeyDown="MessageList_KeyDown"
                         SizeChanged="MessageList_SizeChanged"
                         ScrollViewer.ScrollChanged="MessageList_ScrollChanged">
                  <!-- No built-in 1 px padding: rows start exactly where the column header starts, at every display scale. -->
                  <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                      <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                    HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                      </ScrollViewer>
                    </ControlTemplate>
                  </ListBox.Template>
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate><TextBlock Text="{Binding Items[0].AccountName}" Padding="8,8,8,4" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/></DataTemplate>
                      </GroupStyle.HeaderTemplate>
                      <!-- No indent for grouped rows, so they keep the same columns as the From / Subject / Received header. -->
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                  <ContentPresenter/>
                                  <ItemsPresenter/>
                                </StackPanel>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Height" Value="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <!-- Row states: hover = soft surface; selected = selected surface plus a 3 px accent edge (so selection
                               never depends on color alone and differs from unread, which is a dot plus heavier text). -->
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="0" SnapsToDevicePixels="True">
                              <Grid>
                                <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5" Background="{DynamicResource BrandBrush}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="{StaticResource RadiusTip}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="{StaticResource RadiusTip}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding AccessibilityName}"
                            ui:MailColumns.Apply="True">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FromName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                   Style="{StaticResource UnreadText}" ToolTip="{Binding FromAddress}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Style="{StaticResource UnreadText}"/>
                        <ui:Alondra1Icon Grid.Column="3" Kind="Attachment" IconSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TimeLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding DataContext.ShowTimeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ListPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding ShowListPlaceholder, Converter={StaticResource BoolVis}}">
                  <ui:Alondra1Icon Kind="Inbox" IconSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                  <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2"/>
                  <TextBlock Text="{Binding EmptyDetail}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Clear filters" Click="ClearFilters_Click" HorizontalAlignment="Center" Margin="0,12,0,0"
                          Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <!-- Reading pane: same 16 px padding and 48 px header row as the list. The row holds the storage state (small,
               secondary) and the HTML | Plain text switch; subject, sender, recipients, date, image bar, and attachments
               follow 12 px below; the body (MailBodyView, isolated WebView2) fills the rest with the only scroll bar. -->
          <Border x:Name="ReaderPane" Style="{StaticResource ContentPane}">
            <DockPanel>
              <Grid x:Name="ReaderHeader" DockPanel.Dock="Top" Style="{StaticResource PaneHeaderRow}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- One pane at a time (narrow windows): back to the list, keeping its selection and scroll position. -->
                  <Button x:Name="ReaderBackButton" Style="{StaticResource IconButton}" Click="ReaderBack_Click" Margin="0,0,8,0"
                          AutomationProperties.Name="Back to the list" ToolTip="Back to the list (Esc)"
                          Visibility="{Binding ShowBackButton, Converter={StaticResource BoolVis}}">
                    <ui:Alondra1Icon Kind="Back" IconSize="18"/>
                  </Button>
                  <ui:Alondra1Icon Kind="MarkRead" IconSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ReaderStatus" Text="{Binding ReaderStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             Margin="{StaticResource PaneControlGapLeft}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- HTML | Plain text: HTML is selected when the message has it; without HTML the switch is hidden. -->
                <Border x:Name="FormatSwitch" Grid.Column="1" Background="{DynamicResource SubtleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="2" VerticalAlignment="Center"
                        Visibility="{Binding HasHtml, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Message format">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="HtmlFormatButton" Content="HTML" Style="{StaticResource ModeButton}" MinHeight="28" Padding="12,0" Tag="{Binding ShowingHtml}"
                            Command="{Binding ShowHtmlCommand}" AutomationProperties.Name="Show HTML" ToolTip="Show the formatted message"/>
                    <Button x:Name="PlainFormatButton" Content="Plain text" Style="{StaticResource ModeButton}" MinHeight="28" Padding="12,0" Tag="{Binding ShowingPlain}"
                            Command="{Binding ShowPlainCommand}" AutomationProperties.Name="Show plain text" ToolTip="Show the message as plain text"/>
                  </StackPanel>
                </Border>
              </Grid>
              <!-- Message header (Mail UI spec §6.1): subject; sender (local initials, name, address) with the message actions;
                   recipients and the receiving account with the date; Details expands the full metadata. Hidden without a message. -->
              <StackPanel x:Name="ReaderMessageHeader" DockPanel.Dock="Top" Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}">
                <TextBlock x:Name="ReaderSubjectText" Text="{Binding ReaderSubject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{StaticResource PaneSectionGapTop}"
                           AutomationProperties.HeadingLevel="Level2"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SelectedBrush}" VerticalAlignment="Top" Margin="0,2,10,0"
                          AutomationProperties.Name="Sender">
                    <TextBlock Text="{Binding ReaderInitials}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="ReaderSenderButton" Style="{StaticResource ColumnHeaderButton}" FontSize="14" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"
                            Click="ReaderSender_Click" AutomationProperties.Name="{Binding ReaderSender, StringFormat=Sender {0}. Open sender actions}"
                            ToolTip="Copy the address or write to the sender">
                      <TextBlock Text="{Binding ReaderSenderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                    </Button>
                    <TextBlock Text="{Binding ReaderSenderAddress}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ReaderSenderAddress}" Visibility="{Binding HasReaderSenderAddress, Converter={StaticResource BoolVis}}"/>
                  </StackPanel>
                  <!-- The same commands as the toolbar (same state), next to the message they act on. -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ReplyCommand}" AutomationProperties.Name="Reply" ToolTip="Reply (Ctrl+R)">
                      <ui:Alondra1Icon Kind="Reply" IconSize="18"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ReplyAllCommand}" AutomationProperties.Name="Reply all" ToolTip="Reply all">
                      <ui:Alondra1Icon Kind="ReplyAll" IconSize="18"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" AutomationProperties.Name="Forward" ToolTip="Forward (Ctrl+Shift+F)">
                      <ui:Alondra1Icon Kind="Forward" IconSize="18"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <DockPanel Margin="46,6,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource ColumnHeaderButton}" FontSize="12" Click="ReaderDetails_Click" VerticalAlignment="Top"
                          Content="{Binding ReaderDetailsLabel}" AutomationProperties.Name="{Binding ReaderDetailsLabel, StringFormat='{}{0}: recipients, account, date and storage'}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ReaderTo}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReaderTo}"
                               Visibility="{Binding HasReaderTo, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReaderDateFull}">
                      <Run Text="{Binding ReaderMeta, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
                <!-- Details: every recipient, the receiving account (name and address), the full date with time zone, and storage. -->
                <Border Margin="46,8,0,0" Padding="12,8" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SubtleBrush}"
                        Visibility="{Binding ReaderDetailsOpen, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Message details">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="From" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBox Grid.Column="1" Text="{Binding ReaderSender, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="To" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,4"
                               Visibility="{Binding HasReaderRecipients, Converter={StaticResource BoolVis}}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReaderRecipientsFull, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,0,0,4"
                             Visibility="{Binding HasReaderRecipients, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Grid.Row="2" Text="Account" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ReaderAccountLabel, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="3" Text="Received" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReaderDateFull, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Text="Storage" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReaderStatus, Mode=OneWay}" Style="{StaticResource ReadOnlyText}"/>
                  </Grid>
                </Border>
              </StackPanel>
              <!-- Remote images: blocked by default (no proxy, so loading reveals this PC's address to the image host). -->
              <Border x:Name="ImageBar" DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12,8" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SubtleBrush}"
                      Visibility="{Binding ShowImageBar, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Remote images">
                <StackPanel>
                  <DockPanel>
                    <ui:Alondra1Icon Kind="Image" IconSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ImageBarText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </DockPanel>
                  <WrapPanel Margin="24,6,0,0">
                    <Button Content="Load images" Style="{StaticResource CompactButton}" Command="{Binding LoadImagesCommand}" Margin="0,0,8,0"
                            ToolTip="Load the images of this message. The image hosts can see that the message was opened and this PC's internet address."/>
                    <Button Style="{StaticResource QuietButton}" Command="{Binding TrustSenderCommand}" MaxWidth="320"
                            ToolTip="Always load images from this sender. Change the list in Settings → Mail.">
                      <TextBlock Text="{Binding TrustSenderLabel}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border x:Name="HtmlFailureBar" DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12,8" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource SubtleBrush}"
                      Visibility="{Binding ShowHtmlFailure, Converter={StaticResource BoolVis}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Try HTML again" Style="{StaticResource CompactButton}" Command="{Binding RetryHtmlCommand}" Margin="8,0,0,0"
                          ToolTip="Render the formatted version again. It stays protected: no scripts, no remote content without your consent."/>
                  <ui:Alondra1Icon Kind="Alert" IconSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="The formatted (HTML) version couldn't be shown — showing the plain text." VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
              </Border>
              <!-- Attachments: files only; inline pictures stay in the body. -->
              <ItemsControl x:Name="AttachmentList" DockPanel.Dock="Top" ItemsSource="{Binding Attachments}" Margin="0,12,0,0" AutomationProperties.Name="Attachments"
                            Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,4,4,4" Margin="0,0,8,8" MaxWidth="320"
                            AutomationProperties.Name="{Binding AccessName}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="OpenAttachment_Click" Tag="{Binding}"
                                  AutomationProperties.Name="{Binding FileName, StringFormat='Open {0}'}" ToolTip="Open">
                            <ui:Alondra1Icon Kind="Next" IconSize="14"/>
                          </Button>
                          <Button Style="{StaticResource IconButton}" Width="30" Height="30" Click="SaveAttachment_Click" Tag="{Binding}"
                                  AutomationProperties.Name="{Binding FileName, StringFormat='Save {0}'}" ToolTip="Save as…">
                            <ui:Alondra1Icon Kind="Download" IconSize="14"/>
                          </Button>
                        </StackPanel>
                        <ui:Alondra1Icon Kind="{Binding Kind}" IconSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="8,0,8,0">
                          <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                          <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}" Margin="0,4,0,0"
                      Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>
              <Grid>
                <ui:MailBodyView x:Name="ReaderBody" Margin="0,8,0,0" Document="{Binding ReaderDocument}" AllowRemote="{Binding ReaderAllowRemote}"
                                 FallbackText="{Binding ReaderBody}" Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}}"/>
                <!-- No message open: a quiet centered state like the list's (no empty headers or dividers). -->
                <StackPanel x:Name="ReaderPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                  <ui:Alondra1Icon Kind="Mail" IconSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                  <TextBlock Text="{Binding ReaderEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,2"/>
                  <TextBlock Text="{Binding ReaderEmptyDetail}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
        </shell:MailDockPanel>

        <tasks:TodoView x:Name="TodoPanel" DataContext="{Binding Todo}"
                        Visibility="{Binding Host.IsTasks, Converter={StaticResource BoolVis}}"/>

        <notes:NotesView x:Name="NotesPanel" DataContext="{Binding Notes}"
                         Visibility="{Binding Host.IsNotes, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer Visibility="{Binding ShowOrganizer, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Pane}" Padding="16" MinHeight="365">
            <StackPanel>
              <TextBlock Text="{Binding OrganizerNotice}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <StackPanel Visibility="{Binding IsCalendar, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Days}" AutomationProperties.Name="Calendar days">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Text}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding AccessName}" MinHeight="40" Margin="2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                            <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasEvent}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
                              </DataTrigger>
                              <!-- Weekday names and leading blanks. -->
                              <DataTrigger Binding="{Binding IsDay}" Value="False">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="IsEnabled" Value="False"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="{Binding AgendaText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <!-- The day's events; Meeting notes opens the event's note or starts one (Notes spec 11). -->
                    <ItemsControl ItemsSource="{Binding AgendaEvents}" AutomationProperties.Name="Events of the selected day">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.MeetingNotesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Subject, StringFormat='Meeting notes for {0}'}" ToolTip="Open or start this meeting's notes">
                              <StackPanel Orientation="Horizontal"><ui:Alondra1Icon Kind="Notes" IconSize="15" Margin="0,0,6,0"/><TextBlock Text="Meeting notes"/></StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Subject}" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Time}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Visibility="{Binding IsContacts, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding VisibleContacts}" AutomationProperties.Name="Contacts">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,2" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SelectedBrush}" Margin="0,0,12,0">
                            <ui:Alondra1Icon Kind="Contacts" IconSize="16" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Email}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No matching contacts" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding NoContacts, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- Due task reminders float over the content in every module; they are not a permanent row. -->
        <ItemsControl ItemsSource="{Binding Todo.ActiveReminders}" AutomationProperties.Name="Reminders" Panel.ZIndex="10"
                      HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="560" Margin="0,6,6,0"
                      Visibility="{Binding Todo.HasActiveReminders, Converter={StaticResource BoolVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}"
                      Padding="12,6" Margin="0,0,12,8" Effect="{StaticResource PopupShadow}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Open" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.OpenReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Open task"/>
                    <Button Content="Snooze" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.SnoozeReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Snooze reminder"/>
                    <Button Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.DismissReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Dismiss reminder"/>
                  </StackPanel>
                  <ui:Alondra1Icon Kind="Reminder" IconSize="18" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · reminder " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding When, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                  </TextBlock>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <!-- Dev builds (BuildEnvironment.IsDev) carry a visible badge so test data is never mistaken for real data. -->
      <Border x:Name="DevBadge" Grid.RowSpan="5" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,4,0,0" Padding="8,1" CornerRadius="6" Background="#C2410C" IsHitTestVisible="False"
              AutomationProperties.Name="Development build">
        <TextBlock Text="DEV" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
      </Border>
    </Grid>
  </Border>
</Window>
