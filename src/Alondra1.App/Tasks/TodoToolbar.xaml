<UserControl x:Class="Alondra1.App.Tasks.TodoToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Alondra1.App.Controls">
  <!-- To-do's row in the shared module toolbar: sort, filters, undo, and the More menu. Search is in the app header. -->
  <DockPanel VerticalAlignment="Center" LastChildFill="False">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <!-- Cloud Sync state (only once Cloud Sync was set up); opens Settings → Cloud. -->
      <Button x:Name="CloudButton" Style="{StaticResource IconButton}" Click="CloudButton_Click" Padding="8,0" Width="NaN" Margin="0,0,6,0"
              Visibility="{Binding Host.Cloud.ShowIndicator, Converter={StaticResource BoolVis}}"
              ToolTip="{Binding Host.Cloud.StatusDetail}" AutomationProperties.Name="{Binding Host.Cloud.StatusText, StringFormat='Cloud Sync: {0}'}" AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Alondra1Icon Kind="Upload" IconSize="16" VerticalAlignment="Center"/>
          <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="{DynamicResource AccentWarmBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Host.Cloud.IsHealthy}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding Host.Cloud.StatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)">
        <ui:Alondra1Icon Kind="Undo" IconSize="18"/>
      </Button>
      <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Click="MoreButton_Click"
              AutomationProperties.Name="More to-do actions" ToolTip="Print, import, export, backup, and options">
        <ui:Alondra1Icon Kind="More" IconSize="18"/>
        <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
      </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTaskView, Converter={StaticResource BoolVis}}">
      <ui:Alondra1Icon Kind="Sort" IconSize="16" Foreground="{DynamicResource MutedBrush}" Margin="4,0,6,0" VerticalAlignment="Center"/>
      <ComboBox x:Name="SortBox" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=OneWay}" MinWidth="128"
                SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="Sort tasks by" ToolTip="Sort"/>
      <Button Style="{StaticResource IconButton}" Click="SortDirection_Click" AutomationProperties.Name="Reverse sort order" ToolTip="Reverse order" Margin="2,0,0,0">
        <ui:Alondra1Icon IconSize="16">
          <ui:Alondra1Icon.Style>
            <Style TargetType="ui:Alondra1Icon">
              <Setter Property="Kind" Value="ChevronDown"/>
              <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SortDescending}" Value="True">
                  <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Alondra1Icon.Style>
        </ui:Alondra1Icon>
      </Button>
      <Border Style="{StaticResource ToolbarDivider}"/>
      <StackPanel Orientation="Horizontal" Visibility="{Binding StatusFilterApplies, Converter={StaticResource BoolVis}}">
        <ui:Alondra1Icon Kind="Filter" IconSize="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="StatusBox" ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusIndex, Mode=OneWay}" MinWidth="128"
                  SelectionChanged="StatusBox_SelectionChanged" AutomationProperties.Name="Filter by status" ToolTip="Show"/>
        <ComboBox x:Name="TagFilterBox" ItemsSource="{Binding TagFilterOptions}" SelectedIndex="{Binding TagFilterIndex, Mode=OneWay}" MinWidth="110" MaxWidth="180" Margin="6,0,0,0"
                  SelectionChanged="TagFilterBox_SelectionChanged" AutomationProperties.Name="Filter by tag" ToolTip="Only tasks with this tag"/>
      </StackPanel>
      <Button Style="{StaticResource ModeButton}" Margin="6,0,0,0" Tag="{Binding ImportantOnly}" Click="ImportantFilter_Click"
              AutomationProperties.Name="Only important tasks" ToolTip="Only important tasks">
        <StackPanel Orientation="Horizontal">
          <ui:Alondra1Icon Kind="PriorityFilled" IconSize="16" Foreground="{DynamicResource StarBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ImportantLabel" Text="Important" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </DockPanel>
</UserControl>
