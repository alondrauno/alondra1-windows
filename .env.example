# Optional settings for local development and tests. The app itself reads no .env file:
# set these in your shell (PowerShell: $env:NAME = "value") or in your IDE's test run settings.
# Copy to .env for your own reference; .env is ignored by git.

# .NET SDK installed per-user and not on PATH (see docs/CODE-GUIDE.md):
# DOTNET_ROOT=C:\Users\<you>\AppData\Local\dotnet

# Opt-in 10 GB mailbox scale test (MailboxScaleTests): a scratch folder with enough free space.
# ALONDRA1_SCALE_TEST_ROOT=D:\scratch\alondra1-scale

# Opt-in LiveMailTests against two real mailboxes: path to a local, git-ignored file with the lines
# USER1, PASSWORD1, USER2, PASSWORD2, IMAP, POP3, SMTP (host:port). Never commit that file.
# ALONDRA1_LIVE_MAIL_FILE=C:\Users\<you>\alondra1-live-mail.txt

# Rewrite contract/fixtures after an intended task-model change (ContractSchemaTests), then copy
# contract/ to alondra1-backend in the same change.
# ALONDRA1_UPDATE_FIXTURES=1
