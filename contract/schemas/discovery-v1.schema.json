{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alondra1.com/schemas/discovery-v1.schema.json",
  "title": "Alondra1 cloud discovery manifest v1",
  "description": "Signed list of API endpoints for one environment. The signature (manifest.json.sig) covers the exact bytes. Structural rules only; the verification rules in discovery/README.md (signature, environment, validity, version, host allowlist) are normative.",
  "type": "object",
  "required": ["schema", "environment", "version", "issued_at", "expires_at", "endpoints"],
  "properties": {
    "schema": { "const": "alondra1.discovery/v1" },
    "environment": { "enum": ["dev", "prod"] },
    "version": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "region", "priority", "enabled", "service", "api_versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "url": { "type": "string", "pattern": "^https://[a-z0-9.-]+/?$" },
          "region": { "type": "string", "pattern": "^[a-z0-9]{2,16}$" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "enabled": { "type": "boolean" },
          "service": { "const": "alondra1-api" },
          "api_versions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
